# 依赖目录
node_modules/

# 数据文件（大文件）
backend/data/before/
backend/data/cleaned/
backend/data/*.json
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/backup/

# 环境变量文件
.env
.env.local
.env.*.local

# 构建产物
dist/
build/

# 测试产物
tests/artifacts/

# 日志文件
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 编辑器配置文件
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db

# Python 虚拟环境
.venv/
env/

# Python 字节码
__pycache__/
*.pyc

# 临时探针脚本（tests/_*.cjs 是排查用的一次性脚本，不该入库）
tests/_*.cjs

# 临时文件
*.tmp
*.temp
.cache/

# 本地私有材料（不入库，仅本机保留）
大创项目申报材料/
