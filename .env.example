# ============================================================
# 后端环境变量样例（复制为 .env 后填写；.env 不入库）
# ============================================================

# ---- AI（Phase 6.1）----
# 关闭时 /api/ai/health 会如实报告 available=false，不会假装可用
AI_ENABLED=false

# 可选：ollama | siliconflow | mock（mock 仅测试用，禁止生产）
LLM_PROVIDER=ollama

# Ollama（本地）
# Windows 宿主机运行 Ollama 时，容器内需用 host.docker.internal
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.3

# ---- Token 预算（Phase 6.2 Task 3）----
# 上下文窗口 = 输入 + 输出的总窗口（Ollama 的 num_ctx）。
# 实测 8192 时模型仍 100% 驻留显存（3698MB / 8GB 卡）。
LLM_CONTEXT_LENGTH=8192

# 输出预算（Ollama 的 num_predict / SiliconFlow 的 max_tokens）。
# 必须小于上面的窗口，否则输入永远放不下——启动时 validate() 会直接报错。
LLM_MAX_OUTPUT_TOKENS=3072

# 旧变量名仍兼容，但会在 /api/ai/health 的 deprecations 里留下告警：
#   OLLAMA_NUM_CTX      → LLM_CONTEXT_LENGTH
#   LLM_MAX_TOKENS      → LLM_MAX_OUTPUT_TOKENS

# 是否让模型输出思考过程（Qwen3 的 thinking）。
# 实测开启时同一提示消耗 580–664 token，关闭后仅 17 token，且答案质量无可观测差异。
# 保持 false；需要复杂推理时再临时开启并复测。
LLM_ENABLE_THINKING=false

# 模型驻留时间。不设时 Ollama 空闲即卸载，下次请求要重新加载（实测 2.3–4s）。
# 用 0 可让请求后立刻卸载（排查冷启动时用），-1 表示永不卸载。
LLM_KEEP_ALIVE=30m

# 云端备用（可选，密钥只放这里，禁止写进前端）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=

# ---- 知识库 / RAG（Phase 6.2）----
# embedding 用 CPU：与 Ollama 抢 8GB 显存不值得，且两者必须能独立失败
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

# 国内网络 HuggingFace 不可达时用镜像；模型已缓存后不再联网
# HF_ENDPOINT=https://hf-mirror.com

# 留空则落到 backend/data/chroma
CHROMA_PERSIST_DIRECTORY=
CHROMA_COLLECTION=knowledge_chunks

# 候选数量。Phase 6.3 起阈值不再决定能否回答，候选就必须给够——
# 只在 5 条里做证据判断，等于把召回损失转嫁给证据门。
# 50 是实测值：top_k=10 时 q23 的正确答案完全不出现（HNSW 近似搜索），
# 50 时排第 7；同时误拦率 0.032 → 0.000。生成侧另有 LLM_MAX_EVIDENCE 控制上下文。
RAG_TOP_K=50

# 召回下限：只过滤明显不相关的候选，**不决定能否回答**（那由 EvidenceGate 负责）。
# 默认留空 = 不过滤。留 0 和不填是两回事：留 0 会真的按 0 过滤。
RAG_RETRIEVAL_MIN_SCORE=

# 旧变量名 RAG_SCORE_THRESHOLD 仍可读到，但只作为召回下限使用，
# 并会在 /api/ai/health 的 config_warnings 里提示改名。

RAG_MAX_CONTEXT_CHARS=10000

# ---- 新近度重排（Phase 6.3）----
# score + w × exp(-age/tau_days)，只往上抬新鲜文档，旧文档相对次序不变。
# 0.16 是评估集标定的：MRR 0.856→0.952、q06 首条名次 5→1、Recall 不变；
# 0.16–0.30 为平台，0.40 起下降。设 0 可完全关闭。
RAG_RECENCY_WEIGHT=0.16
RAG_RECENCY_TAU_DAYS=30

# ---- 第二层语义复核（Phase 6.3）----
# 默认关闭。实测（36 题 × 3 轮，temperature=0）：程序层已能 5/5 拒答、0 误拦；
# 打开它后拒答仍 5/5，却把 q06/q23/k03 三道可答题判成证据不足。
# 即「只增加误拦、不增加拦截」，因此默认 false；要排查疑难问题时可临时打开。
RAG_SEMANTIC_CHECK=false

# 切分单位是字符，不是 token
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---- 策略生成（Phase 6.4 使用）----
STRATEGY_MIN_ACTIONS=3
STRATEGY_MAX_ACTIONS=5
