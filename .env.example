# ============================================================
# 后端环境变量样例（复制为 .env 后填写；.env 不入库）
# ============================================================

# ---- AI（Phase 6.1）----
# 关闭时 /api/ai/health 会如实报告 available=false，不会假装可用
AI_ENABLED=false

# 可选：ollama | siliconflow | mock（mock 仅测试用，禁止生产）
LLM_PROVIDER=ollama

# Ollama（本地）
# Windows 宿主机运行 Ollama 时，容器内需用 host.docker.internal
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# 云端备用（可选，密钥只放这里，禁止写进前端）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=

# ---- 策略生成（Phase 6.4 使用）----
STRATEGY_MIN_ACTIONS=3
STRATEGY_MAX_ACTIONS=5
